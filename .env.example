# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phone verification (set to "true" to require phone verification before posting)
PHONE_VERIFICATION_ENABLED=true

# Twilio (for SMS phone verification — required when PHONE_VERIFICATION_ENABLED=true)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Map defaults (optional)
NEXT_PUBLIC_MAP_DEFAULT_LAT=33.7701
NEXT_PUBLIC_MAP_DEFAULT_LNG=-118.1937
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Stripe (for match credit purchases — $5.99/match after 5 free matches)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Web Push (VAPID keys for PWA push notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@parkingmeeters.com

# Pilot operations
CRON_SECRET=generate-a-long-random-secret
AGENT_SECRET_KEY=generate-another-long-random-secret
MATCH_RADIUS_METERS=200
MATCH_OFFER_WINDOW_MS=90000

# GitHub-context development agent (server-side only)
GITHUB_TOKEN=github_pat_your_token
GITHUB_REPOSITORY=aioverdose/Parkingapp
GITHUB_DEFAULT_BRANCH=main

# Optional parking research provider (must return the documented strict JSON draft shape)
PARKING_RESEARCH_PROVIDER_URL=

# One-time admin bootstrap (never commit real values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-strong-password
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Identify server-side Overpass/Nominatim traffic. Never expose service credentials in the browser.
OSM_USER_AGENT=ParkingMeeters/1.0 (admin import; contact@example.com)
